# Razorpay TEST MODE keys.
# Get these from: Razorpay Dashboard -> Settings -> API Keys -> Generate Test Key
# (Test mode needs no KYC and is instant. Never put LIVE keys in this project.)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Only needed if you run webhook_server.py with ngrok (optional stretch, see its docstring)
RAZORPAY_WEBHOOK_SECRET=

# Only needed for --ai mode (real LLM diagnosis + commitment extraction).
# Get a free key at https://console.groq.com/keys — no card required.
# Without this set, --ai flags fall back to the deterministic rule-based
# path automatically (see ai_diagnosis.py / promise_tracker.py).
GROQ_API_KEY=

# Optional overrides — sensible defaults are baked into ai_diagnosis.py,
# you shouldn't need to touch these unless you hit rate limits on your
# specific Groq account tier.
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MIN_INTERVAL_SECONDS=0.5
